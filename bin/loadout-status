#!/bin/bash
# Emit the current install state as one JSON object, for jgarza.loadout.
#
#   { "explicit": [pkg…],           # pacman -Qqe
#     "foreign":  [pkg…],           # pacman -Qqm  (AUR / foreign)
#     "apps":     [pkg…],           # explicit pkgs that ship a visible .desktop launcher
#     "flatpak":  [app-id…],        # flatpak list --app --columns=application
#     "plugins":  [ … ],            # verbatim `omarchy plugin list --json`
#     "hyprpm":   [ { "repo": name, "plugins": [ {"name","enabled"} … ] } … ] }
#
# Read-only. No sudo. Safe to poll.
#
# Every tool is invoked by absolute path and PATH is pinned, so a directory
# planted earlier in the caller's PATH cannot substitute code here. Each
# external query runs under its own `timeout`; the overlay additionally bounds
# the whole script (deadline, process-group kill, output cap).

set -uo pipefail
unset IFS CDPATH BASH_ENV ENV
export PATH=/usr/bin:/usr/share/omarchy/bin
umask 077

readonly JQ=/usr/bin/jq PACMAN=/usr/bin/pacman FLATPAK=/usr/bin/flatpak HYPRPM=/usr/bin/hyprpm
readonly OMARCHY=/usr/share/omarchy/bin/omarchy TIMEOUT=/usr/bin/timeout
readonly AWK=/usr/bin/awk SED=/usr/bin/sed GREP=/usr/bin/grep SORT=/usr/bin/sort

# Bound each query: 8s, then SIGKILL 2s later.
t() { "$TIMEOUT" -k 2 8 "$@"; }

lines_to_json() { "$JQ" -R -s 'split("\n") | map(select(length > 0))'; }

[ -x "$JQ" ] || { printf '{}\n'; exit 0; }

_explicit=()
[ -x "$PACMAN" ] && mapfile -t _explicit < <(t "$PACMAN" -Qqe 2>/dev/null)
explicit="$(printf '%s\n' "${_explicit[@]}" | lines_to_json)"
if [ -x "$PACMAN" ]; then foreign="$(t "$PACMAN" -Qqm 2>/dev/null | lines_to_json)"; else foreign="[]"; fi

# "apps": the explicitly-installed packages that a user would recognise as an
# application — they own at least one launcher in /usr/share/applications that is
# not NoDisplay/Hidden. One `pacman -Ql` pass (which prints "pkg /path"), then a
# cheap grep per candidate .desktop file. Excludes libraries, toolchains, base.
if ((${#_explicit[@]})); then
  apps="$(
    t "$PACMAN" -Ql "${_explicit[@]}" 2>/dev/null \
      | "$AWK" '$2 ~ /^\/usr\/share\/applications\/[^\/]+\.desktop$/ { print $1 "\t" $2 }' \
      | while IFS=$'\t' read -r pkg path; do
          [ -r "$path" ] || continue
          "$GREP" -qiE '^(NoDisplay|Hidden)[[:space:]]*=[[:space:]]*true' "$path" && continue
          printf '%s\n' "$pkg"
        done \
      | "$SORT" -u | lines_to_json
  )"
else
  apps="[]"
fi
case "$apps" in \[*) : ;; *) apps="[]" ;; esac

if [ -x "$FLATPAK" ]; then
  flatpak="$(t "$FLATPAK" list --app --columns=application 2>/dev/null | lines_to_json)"
else
  flatpak="[]"
fi
case "$flatpak" in \[*) : ;; *) flatpak="[]" ;; esac

plugins="[]"
[ -x "$OMARCHY" ] && plugins="$(t "$OMARCHY" plugin list --json 2>/dev/null)"
case "$plugins" in
  \[*) : ;;
  *) plugins="[]" ;;
esac

# `hyprpm list` is human-formatted and ANSI-coloured. Strip escapes, then walk:
#   → Repository <repo> (by …):
#     │ Plugin <name>
#     └─ enabled: <true|false>
# awk emits tab-separated records ("R\t<repo>" / "P\t<name>\t<enabled>");
# jq assembles the JSON so names are always properly escaped.
hyprpm="[]"
if [ -x "$HYPRPM" ]; then
  hyprpm="$(
    t "$HYPRPM" list 2>/dev/null \
      | "$SED" -r 's/\x1b\[[0-9;]*m//g' \
      | "$AWK" '
          /Repository[ \t]+[^ \t]/ {
            line = $0
            sub(/.*Repository[ \t]+/, "", line)
            sub(/[ \t]*\(by.*$/, "", line)
            sub(/:[ \t]*$/, "", line)
            gsub(/[ \t]+$/, "", line)
            gsub(/\t/, " ", line)
            print "R\t" line
            next
          }
          /Plugin[ \t]+[^ \t]/ {
            pname = $0
            sub(/.*Plugin[ \t]+/, "", pname)
            gsub(/[ \t]+$/, "", pname)
            gsub(/\t/, " ", pname)
            next
          }
          /enabled:[ \t]*(true|false)/ {
            if (pname != "") print "P\t" pname "\t" (($0 ~ /true/) ? "true" : "false")
            pname = ""
            next
          }
        ' \
      | "$JQ" -R -s '
          split("\n") | map(select(length > 0) | split("\t"))
          | reduce .[] as $r ([];
              if $r[0] == "R" then . + [{repo: $r[1], plugins: []}]
              elif $r[0] == "P" and length > 0 then
                .[-1].plugins += [{name: $r[1], enabled: ($r[2] == "true")}]
              else . end)
        '
  )"
fi
case "$hyprpm" in
  \[*) : ;;
  *) hyprpm="[]" ;;
esac

"$JQ" -nc \
  --argjson explicit "${explicit:-[]}" \
  --argjson foreign "${foreign:-[]}" \
  --argjson apps "${apps:-[]}" \
  --argjson flatpak "${flatpak:-[]}" \
  --argjson plugins "${plugins:-[]}" \
  --argjson hyprpm "${hyprpm:-[]}" \
  '{explicit: $explicit, foreign: $foreign, apps: $apps, flatpak: $flatpak, plugins: $plugins, hyprpm: $hyprpm}'
